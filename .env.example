# PenG Configuration
# Copy this file to .env and fill in your values.
#
# System dependencies required:
# - ffmpeg (video processing / STT audio decode)
# - Tesseract OCR with Vietnamese and English language packs: vie+eng
#   Ubuntu/Debian: sudo apt-get install tesseract-ocr tesseract-ocr-vie tesseract-ocr-eng ffmpeg
#   Windows: install from https://github.com/UB-Mannheim/tesseract/wiki and add to PATH

# LLM
# Lightweight English-first option: Qwen/Qwen2.5-1.5B-Instruct
# Better quality on a T4: Qwen/Qwen2.5-3B-Instruct
# More VRAM: Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_DEVICE=cuda
LLM_QUANTIZE=true

# Optional CPU GGUF runtime (branch experiment/gguf-llama-cpp).
# Set LLM_RUNTIME=llama_cpp and provide a local GGUF path to run on CPU.
# See docs/CPU_GGUF.md for installation and model-source guidance.
# LLM_RUNTIME=transformers
# LLM_GGUF_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# LLM_GGUF_CHAT_FORMAT=chatml
# LLM_GGUF_N_THREADS=4
# LLM_GGUF_N_CTX=4096

# Embedding
EMBEDDING_MODEL=keepitreal/vietnamese-sbert
EMBEDDING_DIM=768

# faster-whisper
WHISPER_MODEL=base

# OCR
# Default engine is "tesseract" (best availability across platforms).
# Use "easyocr" or "surya" (Python <=3.11 only, requires Pillow<11) if installed.
OCR_ENGINE=tesseract

# Storage paths (relative paths resolve to the project root; absolute paths are kept as-is)
# UPLOAD_DIR=uploads
# SQLITE_PATH=peng_history.db
# LIGHTRAG_WORKING_DIR=lightrag_data

# Upload limits
MAX_UPLOAD_SIZE_MB=500
PROCESSING_TIMEOUT_SECONDS=600

# Auth
# Set AUTH_COOKIE_SECURE=true when serving over HTTPS/ngrok.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_MAX_AGE_SECONDS=604800
AUTH_RATE_LIMIT_LOGIN_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
