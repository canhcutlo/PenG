# PenG Configuration
# Copy this file to .env and fill in your values.

# LLM
# Colab T4: Qwen/Qwen2.5-3B-Instruct (~6GB 4-bit, good quality)
# More VRAM: Qwen/Qwen2.5-7B-Instruct
# CPU only: Qwen/Qwen2.5-1.5B-Instruct
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_DEVICE=cuda
LLM_QUANTIZE=true

# Embedding
EMBEDDING_MODEL=keepitreal/vietnamese-sbert
EMBEDDING_DIM=768

# faster-whisper
WHISPER_MODEL=base

# OCR
OCR_ENGINE=surya

# Upload limits
MAX_UPLOAD_SIZE_MB=500
PROCESSING_TIMEOUT_SECONDS=600

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
