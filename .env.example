# PenG Configuration
# Copy this file to .env and fill in your values.

# LLM
LLM_MODEL=Qwen/Qwen2-7B-Instruct
LLM_DEVICE=cuda
LLM_QUANTIZE=true

# Embedding
EMBEDDING_MODEL=keepitreal/vietnamese-sbert
EMBEDDING_DIM=768

# faster-whisper
WHISPER_MODEL=base

# OCR
OCR_ENGINE=surya

# Upload limits
MAX_UPLOAD_SIZE_MB=500
PROCESSING_TIMEOUT_SECONDS=600

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
